// Folder-specific settings
//
// For a full list of overridable settings, and general information on folder-specific settings,
// see the documentation: https://zed.dev/docs/configuring-zed#settings-files
{
  "languages": {
    "Python": {
      // Zed's ruff language server, which runs the ruff in .venv (the dev group's pinned
      // one) when there is one -- the same ruff CI checks with, so a saved file passes
      // `ruff format --check` and `ruff check`'s import sorting.
      "code_actions_on_format": {
        "source.organizeImports.ruff": true
      },
      "formatter": {
        "language_server": {
          "name": "ruff"
        }
      },
      "format_on_save": "on"
    }
  }
}
