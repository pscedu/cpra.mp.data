Bootstrap: docker
From: quay.io/jupyter/scipy-notebook@sha256:15b50ef89a316b483279aa5f689c5b26947e586ddb403c504e65a73b47ff8569

%arguments
    JUPYTER_VERSION=3.2.3

%setup
    mkdir -p $APPTAINER_ROOTFS/usr/src/app

%files
    pyproject.toml /usr/src/app
    README.md /usr/src/app
    cpra /usr/src/app

%post
    # Install any packages required for the kernel-wrapper
    pip install pycrypto

    # Download and extract the enterprise gateway kernel launchers and bootstrap files
    wget https://github.com/jupyter-server/enterprise_gateway/releases/download/v{{ JUPYTER_VERSION }}/jupyter_enterprise_gateway_kernel_image_files-{{ JUPYTER_VERSION }}.tar.gz
    tar -xvf jupyter_enterprise_gateway_kernel_image_files-{{ JUPYTER_VERSION }}.tar.gz -C /usr/local/bin
    rm -f jupyter_enterprise_gateway_kernel_image_files-{{ JUPYTER_VERSION }}.tar.gz
    fix-permissions /usr/local/bin

    # Install the wheel file
    cd /usr/src/app
    pip install .[bridges2] && python -m pip cache purge

%environment
    export JUPYTER_VERSION="{{ JUPYTER_VERSION }}"
    export KERNEL_LANGUAGE="python"

%runscript
    exec /usr/local/bin/bootstrap-kernel.sh "$@"

%startscript
    /usr/local/bin/bootstrap-kernel.sh
